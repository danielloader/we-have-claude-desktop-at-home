# Mode 1: local development with stubs (the defaults). Copy to .env and run.
# See README.md "Running modes" for Mode 2 (real model) and Mode 3 (production).

# APP_LLM_PROVIDER: stub | ollama | anthropic | azure. Leave unset for the defaults:
#   `uv run` -> stub (no dependencies), `docker compose` -> ollama (bundled local model).
# APP_LLM_PROVIDER=stub
APP_CHAT_STORE=sqlite            # sqlite | elastic
APP_TELEMETRY=file               # file | elastic_apm | none

APP_SQLITE_PATH=./data/app.db
APP_TELEMETRY_FILE=./data/telemetry.log   # or /dev/stderr to interleave with the server log
APP_TELEMETRY_FILE_FORMAT=text   # text | jsonl

APP_JWT_SECRET=dev-only-change-me-before-you-deploy-anywhere
APP_JWT_TTL_MINUTES=480
# Seeded on first start if there are no users. Default: admin/admin, alice/alice, bob/bob
# APP_SEED_USERS=[{"username":"admin","password":"admin","is_admin":true},{"username":"alice","password":"alice"}]

# Token budgets (input + output tokens per user per period)
APP_DEFAULT_TOKEN_BUDGET=500000
APP_BUDGET_PERIOD=month          # day | month | all
APP_ENFORCE_TOKEN_BUDGET=true

# Stub provider pacing
APP_STUB_LAG_MIN_S=0.8
APP_STUB_LAG_MAX_S=3.0
APP_STUB_TOKENS_PER_S_MIN=15
APP_STUB_TOKENS_PER_S_MAX=60
APP_STUB_STALL_PROBABILITY=0.03

# Mode 2: real model locally
# --- local CPU model via Ollama on the host or in docker (see README) ---
# APP_LLM_PROVIDER=ollama
# APP_LLM_MODEL=qwen3:0.6b
# APP_OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:0.6b        # compose only: which model the bundled Ollama pulls
# --- Anthropic API ---
# APP_LLM_PROVIDER=anthropic
# APP_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# --- or Claude on Azure AI (Microsoft Foundry) ---
# APP_LLM_PROVIDER=azure
# APP_AZURE_RESOURCE=my-foundry-resource
# APP_AZURE_API_KEY=...

# Mode 3: production backends
# APP_CHAT_STORE=elastic
# APP_ELASTIC_URL=https://es.internal:9200
# APP_ELASTIC_API_KEY=...
# APP_TELEMETRY=elastic_apm
# APP_APM_SERVER_URL=https://apm.internal:8200
# APP_APM_SECRET_TOKEN=...        # or APP_APM_API_KEY
# APP_APM_SERVICE_NAME=claude-at-home
# APP_APM_ENVIRONMENT=production
# APP_SEED_USERS=[]
